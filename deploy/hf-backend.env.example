# Backend Space (multi-llm-backend). Enter these in the Space: Settings > Variables and secrets.
# Do not commit a filled-in copy. Generate random values with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"

# ── Secrets (New secret) ─────────────────────────────────────────────
# Must be identical to INTERNAL_AUTH_KEY on the middleware Space. Without it every /query gets 403,
# and with HEIMDALL_ENV=production the Space refuses to start.
INTERNAL_AUTH_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=

# ── Variables (New variable; visible to anyone who can see the Space) ─
HEIMDALL_ENV=production
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-3.5-flash
MISTRAL_MODEL=mistral-small-latest
# Only browsers check CORS, and nothing calls the backend from a browser. Leave as the middleware URL.
MIDDLEWARE_URL=https://ragas111-heimdall-middleware.hf.space
