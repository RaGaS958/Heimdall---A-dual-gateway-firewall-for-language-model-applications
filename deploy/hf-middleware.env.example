# Middleware Space (heimdall-middleware). Enter these in the Space: Settings > Variables and secrets.
# Do not commit a filled-in copy. Generate each random value with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"

# ── Secrets (New secret) ─────────────────────────────────────────────
ADMIN_KEY=
# rediss://default:<password>@<name>.upstash.io:6379 (see the Redis section below)
REDIS_URL=
# INTERNAL_AUTH_KEY must be the same value as on the backend Space.
INTERNAL_AUTH_KEY=
SESSION_SIGNING_KEY=
# The arbiter calls the providers directly, so the middleware needs keys too (Groq or Gemini at least).
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=

# ── Variables (New variable) ─────────────────────────────────────────
HEIMDALL_ENV=production
MULTI_LLM_BACKEND_URL=https://ragas111-multi-llm-backend.hf.space
# Browser origins allowed by CORS: your Vercel address, plus a custom domain if you add one.
FRONTEND_URL=https://<project>.vercel.app
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-3.5-flash
MISTRAL_MODEL=mistral-small-latest

# Redis (Upstash free tier works). With it, rate limits, session locks and the attack cache are
# shared and survive restarts, and so are the review queue, reviewer labels and audit log.
# Put the rediss:// URL from the Upstash console in a SECRET named REDIS_URL, then:
USE_FAKE_REDIS=false
# Without Redis, set USE_FAKE_REDIS=true: everything above then lives in the process and in files,
# and resets whenever the Space restarts.

# Hugging Face's proxy sits in front. Confirm with the check in deploy/README.md.
TRUSTED_PROXY_HOPS=1

EMBEDDINGS_ENABLED=true
REVIEW_ON_ARBITER_FAILURE=review
ARBITER_CONFLICT_ACTION=review
# keep: markup inside code blocks is left alone. Right only if every client renders answers as
# markdown or plain text (the Heimdall site does). Use strip if anything renders answers as HTML.
G2_CODE_BLOCKS=keep

# ── Only without Redis ───────────────────────────────────────────────
# Files survive restarts only on a mounted Storage Bucket (Settings > Storage Buckets, mount
# path /data, read-write). Then uncomment these:
# REVIEW_QUEUE_PATH=/data/review_queue.json
# REVIEWER_LABELS_PATH=/data/reviewer_labels.jsonl
# AUDIT_LOG_PATH=/data/admin_audit.jsonl
# HONEYPOT_LOG_PATH=/data/honeypot_logs.jsonl
