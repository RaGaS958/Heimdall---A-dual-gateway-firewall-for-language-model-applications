# Copy to .env next to docker-compose.yml. Never commit .env.
# Generate each secret with:  python -c "import secrets; print(secrets.token_urlsafe(32))"

ADMIN_KEY=
INTERNAL_AUTH_KEY=
SESSION_SIGNING_KEY=
REDIS_PASSWORD=

# At least one provider. The arbiter uses Groq first, then Gemini.
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=

# Where people reach the site. Used for CORS; set it to your https:// address on a server.
PUBLIC_URL=http://localhost:8080
# 127.0.0.1 keeps the port private to this machine. Use 0.0.0.0 only behind a TLS proxy.
HEIMDALL_BIND=127.0.0.1
HEIMDALL_PORT=8080

# review: a person decides when the arbiter fails or overrules strong evidence (default).
# legacy / block / allow restore older behaviour; see operations.md.
REVIEW_ON_ARBITER_FAILURE=review
ARBITER_CONFLICT_ACTION=review
# strip = remove active markup everywhere in answers. keep = leave it inside code blocks
# (choose keep only if every client renders answers as markdown or plain text, as the Heimdall UI does).
G2_CODE_BLOCKS=strip
EMBEDDINGS_ENABLED=true
