# HEIMDALL middleware configuration. Copy to .env; never commit the copy.

# development | test | production. Production refuses to start without the three secrets below.
HEIMDALL_ENV=development

# Shared secrets. Generate each with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
ADMIN_KEY=ezzhs81-WlKPpWzaqoghLG7-cOzO6QNI1QAMMOxqP9JjSvQEJTXkCDISSqsURimT
INTERNAL_AUTH_KEY=QqH5mSGpYaGm05c48wl7hMNlIAkr4-mC3VcxJv8dHgWTgDwedphNhJJs8PXp61x8
SESSION_SIGNING_KEY=AxIaZTYKiENzjYakN7Jvk7-Q64VYlHnZmuhBWGVrR6sKURk4j1KF5qGOgjkD0Hbi

# Arbiter providers. Without one of Groq or Gemini, hard signals fail closed (BLOCK).
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# Hosted model IDs change on the vendor's schedule. Verified 2026-11-09.
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-3.5-flash
MISTRAL_MODEL=mistral-small-latest

MULTI_LLM_BACKEND_URL=http://localhost:8001

# Comma-separated list of browser origins allowed by CORS.
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# Number of reverse proxies in front of this service. 0 means ignore X-Forwarded-For.
TRUSTED_PROXY_HOPS=0

# With USE_FAKE_REDIS=false, Redis also holds the review queue, reviewer labels and audit log
# (shared by every instance, kept across restarts). With true, they are files under data/.
USE_FAKE_REDIS=true
REDIS_URL=redis://localhost:6379

# Set EMBEDDINGS_ENABLED=false on hosts that cannot download the 130 MB ONNX model.
EMBEDDINGS_ENABLED=true

# Research-only options. Neither can be on in production.
RESEARCH_MODE=false
HONEYPOT_ENABLED=false
ENABLE_DEBUG_CONSOLE=false

PORT=8000
