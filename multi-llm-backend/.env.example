# Multi-LLM backend configuration. Copy to .env; never commit the copy.
HEIMDALL_ENV=development

# Must equal INTERNAL_AUTH_KEY on the middleware. With no key set, /query rejects every caller.
INTERNAL_AUTH_KEY=

GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

GROQ_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-3.5-flash
MISTRAL_MODEL=mistral-small-latest

MIDDLEWARE_URL=http://localhost:8000
